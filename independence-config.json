    { "value": "immediateParent",      "label": "Immediate Parent", "phrase": "the immediate parent of" },
    { "value": "indirectParent",       "label": "Indirect Parent", "phrase": "an indirect parent of" },
    { "value": "immediateSubsidiary",  "label": "Immediate Subsidiary", "phrase": "an immediate subsidiary of" },
    { "value": "indirectSubsidiary",   "label": "Indirect Subsidiary", "phrase": "an indirect subsidiary of" },
    { "value": "sibling",              "label": "Sibling", "phrase": "a sister company of" },
    { "value": "cousin",               "label": "Cousin", "phrase": "a cousin company of" },
    { "value": "caUltimateParent", "label": "CA - Ultimate Parent", "phrase": "a close affiliate (ultimate parent) of" },
    { "value": "caImmediateParent", "label": "CA - Immediate Parent", "phrase": "a close affiliate (immediate parent) of" },
    { "value": "caIndirectParent", "label": "CA - Indirect Parent", "phrase": "a close affiliate (indirect parent) of" },
    { "value": "caImmediateSubsidiary", "label": "CA - Immediate Subsidiary", "phrase": "a close affiliate (immediate subsidiary) of" },
    { "value": "caIndirectSubsidiary", "label": "CA - Indirect Subsidiary", "phrase": "a close affiliate (indirect subsidiary) of" },
    { "value": "caSibling", "label": "CA - Sibling", "phrase": "a close affiliate (sibling) of" },
    { "value": "caCousin", "label": "CA - Cousin", "phrase": "a close affiliate (cousin) of" }
  ],

  "serviceLinesNote": "[\"*\"] means every service line. The wizard does not ask for a service line yet, so every treatment applies to all of them. Real service lines will be { value, label } pairs too.",

